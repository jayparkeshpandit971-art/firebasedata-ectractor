# ============================================================
# FIXED .HTACCESS - NO REDIRECT LOOP
# ============================================================

RewriteEngine On

# DO NOT force HTTPS - Render already handles it
# Remove the HTTPS redirect to avoid loops

# Route everything to index.php (which handles everything)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# Allow direct access to bot.php and index.php
RewriteRule ^(bot\.php|index\.php)$ - [L]

# Set index
DirectoryIndex index.php bot.php

# Headers
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type"
</IfModule>
